			"boundElements": [],
			"updated": 1786565572556,
			"locked": false,
			"text": "Structure of a MAC Address:\n-> : or - seprated set of Hexadecimal numbers\n-> : for mac or linux (fa:34:f3:a5:09:08\n-> - for windows (fa-34-f3-a5-09-08)\n",
			"rawText": "Structure of a MAC Address:\n-> : or - seprated set of Hexadecimal numbers\n-> : for mac or linux (fa:34:f3:a5:09:08\n-> - for windows (fa-34-f3-a5-09-08)\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Structure of a MAC Address:\n-> : or - seprated set of Hexadecimal numbers\n-> : for mac or linux (fa:34:f3:a5:09:08\n-> - for windows (fa-34-f3-a5-09-08)\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
