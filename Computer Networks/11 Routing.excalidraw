			"versionNonce": 1531188481,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1784492339994,
			"locked": false,
			"text": "-> Destination IP will never change While Travelling but MAC Addresses will always change whenever there is a HOP\n-> Source Ip Changes only once when we Hop from Local to Internet\n-> A record is Maintained of initial source Ip and Port on how it was changed\n-> Port is also changed when Hop form Local to Internet",
			"rawText": "-> Destination IP will never change While Travelling but MAC Addresses will always change whenever there is a HOP\n-> Source Ip Changes only once when we Hop from Local to Internet\n-> A record is Maintained of initial source Ip and Port on how it was changed\n-> Port is also changed when Hop form Local to Internet",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "-> Destination IP will never change While Travelling but MAC Addresses will always change whenever there is a HOP\n-> Source Ip Changes only once when we Hop from Local to Internet\n-> A record is Maintained of initial source Ip and Port on how it was changed\n-> Port is also changed when Hop form Local to Internet",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		}
