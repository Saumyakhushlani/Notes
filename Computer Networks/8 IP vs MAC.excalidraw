			"boundElements": [],
			"updated": 1784401616213,
			"locked": false,
			"text": "-> 192.168.1.10\n-> 32 bit integer seprated\n by dot\n-> When Again connected to \nsame router can be changed\n-> IP can be also Duplicated \nin different Network.\n-> Logical Significance over \nInternet to travel.\n-> IP is used to travel from \nsource to destination in \nInternet.",
			"rawText": "-> 192.168.1.10\n-> 32 bit integer seprated\n by dot\n-> When Again connected to \nsame router can be changed\n-> IP can be also Duplicated \nin different Network.\n-> Logical Significance over \nInternet to travel.\n-> IP is used to travel from \nsource to destination in \nInternet.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "-> 192.168.1.10\n-> 32 bit integer seprated\n by dot\n-> When Again connected to \nsame router can be changed\n-> IP can be also Duplicated \nin different Network.\n-> Logical Significance over \nInternet to travel.\n-> IP is used to travel from \nsource to destination in \nInternet.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "VwVJZown",
			"type": "text",
			"x": -61.41746301928157,
			"y": -130.27412044389817,
			"width": 721.6395263671875,
			"height": 225,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "a5",
			"roundness": null,
			"seed": 243361089,
			"version": 460,
			"versionNonce": 1683988303,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1784401562948,
			"locked": false,
			"text": "-> 00:04:1a:af:33:2a \n-> 48 bit separated by : or -\n-> Don't Change (Constant)\n-> Remains constant in all the Network\n-> Once reached the Local Network we will require the\n MAC address to send the data to exact Network interface\n-> ARP - Address Resolution Protocol \n(Takes the IP and return the MAC address of the IP) \n-> MAC Address is only required when we have reached the local Network. ",
			"rawText": "-> 00:04:1a:af:33:2a \n-> 48 bit separated by : or -\n-> Don't Change (Constant)\n-> Remains constant in all the Network\n-> Once reached the Local Network we will require the\n MAC address to send the data to exact Network interface\n-> ARP - Address Resolution Protocol \n(Takes the IP and return the MAC address of the IP) \n-> MAC Address is only required when we have reached the local Network. ",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "-> 00:04:1a:af:33:2a \n-> 48 bit separated by : or -\n-> Don't Change (Constant)\n-> Remains constant in all the Network\n-> Once reached the Local Network we will require the\n MAC address to send the data to exact Network interface\n-> ARP - Address Resolution Protocol \n(Takes the IP and return the MAC address of the IP) \n-> MAC Address is only required when we have reached the local Network. ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		}
