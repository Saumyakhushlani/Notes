			"groupIds": [],
			"frameId": null,
			"index": "av",
			"roundness": null,
			"seed": 1615211631,
			"version": 657,
			"versionNonce": 1433633327,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1784403478623,
			"locked": false,
			"text": "PS -> To Transfer Data From Host A1 to Host A3 (With In the Network):\n-> Host A1 try to Find MAC address of Host A3\n-> Host A1 makes the ARP request inside the Network (What is MAC of 192.168.1.4)\n->ARP request is a broadcast request (to all device)\n-> Only Host A3 will respond to this request\n-> This response will be cached in the ARP Table\n-> ARP table will also have my own IP to MAC entry.\n",
			"rawText": "PS -> To Transfer Data From Host A1 to Host A3 (With In the Network):\n-> Host A1 try to Find MAC address of Host A3\n-> Host A1 makes the ARP request inside the Network (What is MAC of 192.168.1.4)\n->ARP request is a broadcast request (to all device)\n-> Only Host A3 will respond to this request\n-> This response will be cached in the ARP Table\n-> ARP table will also have my own IP to MAC entry.\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "PS -> To Transfer Data From Host A1 to Host A3 (With In the Network):\n-> Host A1 try to Find MAC address of Host A3\n-> Host A1 makes the ARP request inside the Network (What is MAC of 192.168.1.4)\n->ARP request is a broadcast request (to all device)\n-> Only Host A3 will respond to this request\n-> This response will be cached in the ARP Table\n-> ARP table will also have my own IP to MAC entry.\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
