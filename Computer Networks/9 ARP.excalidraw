			"x": -72.76321890605698,
			"y": 531.3972250532985,
			"width": 821.5995483398438,
			"height": 200,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#ffc9c9",
			"fillStyle": "solid",
			"strokeWidth": 2,
