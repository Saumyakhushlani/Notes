			"boundElements": [],
			"updated": 1784385660322,
			"locked": false,
			"text": "Because CIDR was 24 so we used 255.255.255.0 as first 3 octet are same\nFor CIDR 16 the subnet will be 255.255.0.0\nSo Subnet Confirmed that the Mobile and Laptop are inside the same Network",
			"rawText": "Because CIDR was 24 so we used 255.255.255.0 as first 3 octet are same\nFor CIDR 16 the subnet will be 255.255.0.0\nSo Subnet Confirmed that the Mobile and Laptop are inside the same Network",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Because CIDR was 24 so we used 255.255.255.0 as first 3 octet are same\nFor CIDR 16 the subnet will be 255.255.0.0\nSo Subnet Confirmed that the Mobile and Laptop are inside the same Network",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
