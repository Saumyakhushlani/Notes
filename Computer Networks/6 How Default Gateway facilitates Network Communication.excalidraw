			"index": "b07",
			"roundness": null,
			"seed": 1094723745,
			"version": 509,
			"versionNonce": 1924262273,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1784396121591,
			"locked": false,
			"text": "Case 1 : Host A1 wants to send data to Host A3",
			"rawText": "Case 1 : Host A1 wants to send data to Host A3",
			"fontSize": 28,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Case 1 : Host A1 wants to send data to Host A3",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "kUku8Icz",
			"type": "text",
			"x": -128.99148587051604,
			"y": 330.58906454056046,
			"width": 605.1996459960938,
			"height": 125,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#b2f2bb",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b08",
			"roundness": null,
			"seed": 951699375,
			"version": 595,
			"versionNonce": 2106217409,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1784396367669,
			"locked": false,
			"text": "1. Takes it's own IP and Subnet Mask and Find Result IP\n2. Take Host A3 Ip and Subnet Mask and Fond it's Result IP\n3. Compare Both IP if Same (Then in Same Network)\n4. Can Directly send data from Host A1 to Host A3\nIn some cases requires to send via router as well.",
			"rawText": "1. Takes it's own IP and Subnet Mask and Find Result IP\n2. Take Host A3 Ip and Subnet Mask and Fond it's Result IP\n3. Compare Both IP if Same (Then in Same Network)\n4. Can Directly send data from Host A1 to Host A3\nIn some cases requires to send via router as well.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. Takes it's own IP and Subnet Mask and Find Result IP\n2. Take Host A3 Ip and Subnet Mask and Fond it's Result IP\n3. Compare Both IP if Same (Then in Same Network)\n4. Can Directly send data from Host A1 to Host A3\nIn some cases requires to send via router as well.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "DHBml1qU",
			"type": "text",
			"x": -142.0267423925584,
			"y": 514.0890819791765,
			"width": 681.7157592773438,
			"height": 35,
			"angle": 0,
			"strokeColor": "#2f9e44",
			"backgroundColor": "#b2f2bb",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b09",
			"roundness": null,
			"seed": 1266308047,
			"version": 584,
			"versionNonce": 915012943,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1784396139358,
			"locked": false,
			"text": "Case 2 : Host A1 wants to send data to Host B3",
			"rawText": "Case 2 : Host A1 wants to send data to Host B3",
			"fontSize": 28,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Case 2 : Host A1 wants to send data to Host B3",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "c7R9sJIz",
			"type": "text",
			"x": -133.48299762414314,
			"y": 555.9462073977033,
			"width": 736.4194946289062,
			"height": 175,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "#b2f2bb",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0A",
			"roundness": null,
			"seed": 1899784897,
			"version": 906,
			"versionNonce": 171192705,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1784396979630,
			"locked": false,
			"text": "1. Takes it's own IP and Subnet Mask and Find Result IP\n2. Take Host B3 IP and Subnet Mask and Fond it's Result IP\n3. Compare Both IP if Different (Then in Different Network)\n4. Host A1 will send the data to the default gateway i.e Router\n5. Now Router will check if any other network connected to it has same IP\nthat was the result of subnet mask of Host B3.  \n6. If present then pass the data to Host B3.",
			"rawText": "1. Takes it's own IP and Subnet Mask and Find Result IP\n2. Take Host B3 IP and Subnet Mask and Fond it's Result IP\n3. Compare Both IP if Different (Then in Different Network)\n4. Host A1 will send the data to the default gateway i.e Router\n5. Now Router will check if any other network connected to it has same IP\nthat was the result of subnet mask of Host B3.  \n6. If present then pass the data to Host B3.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. Takes it's own IP and Subnet Mask and Find Result IP\n2. Take Host B3 IP and Subnet Mask and Fond it's Result IP\n3. Compare Both IP if Different (Then in Different Network)\n4. Host A1 will send the data to the default gateway i.e Router\n5. Now Router will check if any other network connected to it has same IP\nthat was the result of subnet mask of Host B3.  \n6. If present then pass the data to Host B3.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
