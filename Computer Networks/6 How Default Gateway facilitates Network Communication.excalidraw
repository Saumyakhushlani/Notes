		},
		{
			"id": "yvDgXENm",
			"type": "text",
			"x": -129.5351367781447,
			"y": 291.45179818382235,
			"width": 671.6917724609375,
			"height": 35,
			"angle": 0,
			"strokeColor": "#2f9e44",
			"backgroundColor": "#b2f2bb",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
