			"versionNonce": 894461050,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1785674707078,
			"locked": false,
			"text": "This protocol Helps us to notify errors, or\n events that are happening on the network to source using the IP Address.",
			"rawText": "This protocol Helps us to notify errors, or\n events that are happening on the network to source using the IP Address.",
			"fontSize": 20,
