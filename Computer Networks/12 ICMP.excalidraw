			"isDeleted": false,
			"boundElements": [],
			"updated": 1785674782842,
			"locked": false,
			"text": "Ping -> It is a network utility that we use to determine any server is up or down\nand if up then what is round trip time or latency.",
			"rawText": "Ping -> It is a network utility that we use to determine any server is up or down\nand if up then what is round trip time or latency.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Ping -> It is a network utility that we use to determine any server is up or down\nand if up then what is round trip time or latency.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "rBJxmOjt",
			"type": "text",
			"x": -93.93195825605153,
			"y": 216.84779177712628,
			"width": 493.85968017578125,
			"height": 50,
			"angle": 0,
			"strokeColor": "#e03131",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
