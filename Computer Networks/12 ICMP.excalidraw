			"isDeleted": false,
			"boundElements": [],
			"updated": 1785675137004,
			"locked": false,
			"text": "Host is unreachable\nPort is not reachable\nTTL -> Time to Live (Used to detect Infinite Loop)\nAll the above messages will be sent in the form of ICMP.",
			"rawText": "Host is unreachable\nPort is not reachable\nTTL -> Time to Live (Used to detect Infinite Loop)\nAll the above messages will be sent in the form of ICMP.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "center",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Host is unreachable\nPort is not reachable\nTTL -> Time to Live (Used to detect Infinite Loop)\nAll the above messages will be sent in the form of ICMP.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
		{
			"id": "HTgHOXm4",
			"type": "text",
			"x": -237.199951171875,
			"y": 126.79998779296875,
			"width": 795.51953125,
			"height": 50,
			"angle": 0,
			"strokeColor": "#2f9e44",
