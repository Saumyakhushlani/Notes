		{
			"id": "oKJjaG6K",
			"type": "text",
			"x": 85.17781896734314,
			"y": 1296.0970236606363,
			"width": 1014.2593383789062,
			"height": 150,
			"angle": 0,
			"strokeColor": "#1971c2",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0A",
			"roundness": null,
			"seed": 1273165031,
			"version": 797,
			"versionNonce": 1090858025,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1787584586852,
			"locked": false,
			"text": "-> Ping Internally creates ICMP echo request, a request which follows ICMP protocol\n-> When the request reaches the destination IP it generates the \nICMP echo reply and sends it back to the Source IP\n-> The time between sending the request and again recieving the reply is called RTT (Round Trip Time)\n-> That how ping detects the Latency of Google.\n",
			"rawText": "-> Ping Internally creates ICMP echo request, a request which follows ICMP protocol\n-> When the request reaches the destination IP it generates the \nICMP echo reply and sends it back to the Source IP\n-> The time between sending the request and again recieving the reply is called RTT (Round Trip Time)\n-> That how ping detects the Latency of Google.\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "-> Ping Internally creates ICMP echo request, a request which follows ICMP protocol\n-> When the request reaches the destination IP it generates the \nICMP echo reply and sends it back to the Source IP\n-> The time between sending the request and again recieving the reply is called RTT (Round Trip Time)\n-> That how ping detects the Latency of Google.\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
