			"lineHeight": 1.25,
			"hasTextLink": false
		},
		{
			"id": "uzcmvapk",
			"type": "text",
			"x": 119.71835680751383,
			"y": 2080.946015180747,
			"width": 1185.479248046875,
			"height": 50,
			"angle": 0,
			"strokeColor": "#2f9e44",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0V",
			"roundness": null,
			"seed": 1664363753,
			"version": 402,
			"versionNonce": 1403475303,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1787585911916,
			"locked": false,
			"text": "-> As the name suggest Traceroute helps in tracing the path which the message takes to go from source to destination.\n-> The IP address of different routers through which the message gets hopped is Traceroute.",
			"rawText": "-> As the name suggest Traceroute helps in tracing the path which the message takes to go from source to destination.\n-> The IP address of different routers through which the message gets hopped is Traceroute.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "-> As the name suggest Traceroute helps in tracing the path which the message takes to go from source to destination.\n-> The IP address of different routers through which the message gets hopped is Traceroute.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
