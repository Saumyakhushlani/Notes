			"versionNonce": 581860871,
			"isDeleted": false,
			"boundElements": null,
			"updated": 1787584824915,
			"locked": false,
			"text": "-> As normal the source will ping the Destination through ICMP echo request\n-> If Router (40.0.0.1) finds that destination IP don't exist then it send back a reply with some\nerror message and sends back to the source.\n",
			"rawText": "-> As normal the source will ping the Destination through ICMP echo request\n-> If Router (40.0.0.1) finds that destination IP don't exist then it send back a reply with some error message and sends back to the source.\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "-> As normal the source will ping the Destination through ICMP echo request\n-> If Router (40.0.0.1) finds that destination IP don't exist then it send back a reply with some error message and sends back to the source.\n",
			"autoResize": false,
			"lineHeight": 1.25,
			"hasTextLink": false
		},
