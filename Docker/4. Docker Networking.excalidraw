      "boundElements": [],
      "updated": 1793911968583,
      "locked": false,
      "text": "-> Docker Networking is a mechanism that allows Docker containers to communicate with each other, the\nhost machine, and external networks. It provides network isolation and connectivity between containers.",
      "rawText": "-> Docker Networking is a mechanism that allows Docker containers to communicate with each other, the host machine, and external networks. It provides network isolation and connectivity between containers.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Docker Networking is a mechanism that allows Docker containers to communicate with each other, the host machine, and external networks. It provides network isolation and connectivity between containers.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
