    },
    {
      "id": "KgamazaE",
      "type": "text",
      "x": -417.62565199696337,
      "y": 3078.4156889452715,
      "width": 1246.0221559449453,
      "height": 105,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2N",
      "roundness": null,
      "seed": 483417478,
      "version": 354,
      "versionNonce": 320153754,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793991556780,
      "locked": false,
      "text": "-> Overlay networks connect multiple Docker daemons together and enable Swarm services\nand containers to communicate across nodes. This strategy removes the need to do OS-\nlevel routing.",
      "rawText": "-> Overlay networks connect multiple Docker daemons together and enable Swarm services and containers to communicate across nodes. This strategy removes the need to do OS-level routing.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Overlay networks connect multiple Docker daemons together and enable Swarm services and containers to communicate across nodes. This strategy removes the need to do OS-level routing.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
      "id": "s9MlShaI",
      "type": "text",
      "x": -2.336829590064326,
      "y": 3267.7250474642897,
      "width": 320.0118713378906,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
