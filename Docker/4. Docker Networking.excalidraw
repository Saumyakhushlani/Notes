      "seed": 1073657114,
      "version": 454,
      "versionNonce": 1231597318,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793991482426,
      "locked": false,
      "text": "-> In Host mode of Networking instead of container being connected to a isolated\nenvironment it instead gets directly connected to host IP and all.\n-> Doesn't work well in MAC.\n-> Advantage : No more need to do port mapping.",
      "rawText": "-> In Host mode of Networking instead of container being connected to a isolated environment it instead gets directly connected to host IP and all.\n-> Doesn't work well in MAC.\n-> Advantage : No more need to do port mapping.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> In Host mode of Networking instead of container being connected to a isolated environment it instead gets directly connected to host IP and all.\n-> Doesn't work well in MAC.\n-> Advantage : No more need to do port mapping.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
