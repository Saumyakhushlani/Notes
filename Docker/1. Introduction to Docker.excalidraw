    {
      "id": "ollL5Tdu",
      "type": "text",
      "x": 31.4000244140625,
      "y": 781.3000183105469,
      "width": 621.0394287109375,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
