      "versionNonce": 1726340602,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793828228642,
      "locked": false,
      "text": "2. Dockerization : Works on principal that it shares the same hardware and kernel level. We can Share low memory docker image.\n-> With the help of Docker Engines we can run multiple containers. Container is just and environment of OS not complete OS.",
      "rawText": "2. Dockerization : Works on principal that it shares the same hardware and kernel level. We can Share low memory docker image.\n-> With the help of Docker Engines we can run multiple containers. Container is just and environment of OS not complete OS.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Dockerization : Works on principal that it shares the same hardware and kernel level. We can Share low memory docker image.\n-> With the help of Docker Engines we can run multiple containers. Container is just and environment of OS not complete OS.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
