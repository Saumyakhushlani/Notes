    },
    {
      "id": "MCTYJPMu",
      "type": "text",
      "x": -310.5999755859375,
      "y": 152.20001220703125,
      "width": 654.415283203125,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 0.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 1006132262,
      "version": 436,
      "versionNonce": 1522137446,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793826766955,
      "locked": false,
      "text": "-> First of all we have to provide a list of all the local dependencies.\n-> Second, still there is a chance of version mismatching even if the list is provided.\n-> For every new tool/dependency installed we have to communicate it again.",
      "rawText": "-> First of all we have to provide a list of all the local dependencies.\n-> Second, still there is a chance of version mismatching even if the list is provided.\n-> For every new tool/dependency installed we have to communicate it again.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> First of all we have to provide a list of all the local dependencies.\n-> Second, still there is a chance of version mismatching even if the list is provided.\n-> For every new tool/dependency installed we have to communicate it again.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
      "id": "3uE15CaN",
      "type": "text",
      "x": -311.2000732421875,
      "y": 239.20001220703125,
      "width": 655.9034423828125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 0.5,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 729781562,
      "version": 284,
      "versionNonce": 423746726,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793826766955,
      "locked": false,
      "text": "-> We need something to keep in sync all the dependencies along with thier versions.\n-> Also we have to have same environment in all machine win , mac and linux.",
      "rawText": "-> We need something to keep in sync all the dependencies along with thier versions.\n-> Also we have to have same environment in all machine win , mac and linux.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> We need something to keep in sync all the dependencies along with thier versions.\n-> Also we have to have same environment in all machine win , mac and linux.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
      "id": "DpmosqKw",
      "type": "text",
      "x": -147.29991149902344,
      "y": 359.5,
      "width": 265.37933349609375,
      "height": 32.20001220703127,
      "angle": 0,
