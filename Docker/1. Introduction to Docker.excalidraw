      "isDeleted": false,
      "boundElements": null,
      "updated": 1793828133362,
      "locked": false,
      "text": "1. Virtualization : Create a virtual machine and install all the required Dev tools along with version on that VM.\n-> Share this virtual machine with different developers and also can use it in production. Seperate kernel.",
      "rawText": "1. Virtualization : Create a virtual machine and install all the required Dev tools along with version on that VM.\n-> Share this virtual machine with different developers and also can use it in production. Seperate kernel.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Virtualization : Create a virtual machine and install all the required Dev tools along with version on that VM.\n-> Share this virtual machine with different developers and also can use it in production. Seperate kernel.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
