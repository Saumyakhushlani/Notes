    {
      "id": "6dmKugQQ",
      "type": "text",
      "x": -92.5999755859375,
      "y": -115.79998779296875,
      "width": 460.9918518066406,
      "height": 35,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
