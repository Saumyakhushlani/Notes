      "text": "Networking in Docker Compose",
      "rawText": "Networking in Docker Compose",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Networking in Docker Compose",
