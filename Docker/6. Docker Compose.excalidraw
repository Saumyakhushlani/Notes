    {
      "id": "x7QEybiL",
      "type": "text",
      "x": 334.9979628038574,
      "y": 2777.957856496996,
      "width": 737,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1724562758,
      "version": 320,
      "versionNonce": 927113030,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793998076546,
      "locked": false,
      "text": "name: e-commerce\n\nservices:\n  backend:\n    build: .\n    container_name: backend\n    ports:\n      - \"3000:3000\"\n    environment:\n      DATABASE_URL: postgresql://postgres:postgres@db:5432/postgres\n      REDIS_URL: redis://redis:6379\n\n  db:\n    image: postgres:16\n    environment:\n      POSTGRES_PASSWORD: postgres\n      POSTGRES_USER: postgres\n      POSTGRES_DB: postgres\n\n  redis:\n    image: redis:7-alpine",
      "rawText": "name: e-commerce\n\nservices:\n  backend:\n    build: .\n    container_name: backend\n    ports:\n      - \"3000:3000\"\n    environment:\n      DATABASE_URL: postgresql://postgres:postgres@db:5432/postgres\n      REDIS_URL: redis://redis:6379\n\n  db:\n    image: postgres:16\n    environment:\n      POSTGRES_PASSWORD: postgres\n      POSTGRES_USER: postgres\n      POSTGRES_DB: postgres\n\n  redis:\n    image: redis:7-alpine",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "name: e-commerce\n\nservices:\n  backend:\n    build: .\n    container_name: backend\n    ports:\n      - \"3000:3000\"\n    environment:\n      DATABASE_URL: postgresql://postgres:postgres@db:5432/postgres\n      REDIS_URL: redis://redis:6379\n\n  db:\n    image: postgres:16\n    environment:\n      POSTGRES_PASSWORD: postgres\n      POSTGRES_USER: postgres\n      POSTGRES_DB: postgres\n\n  redis:\n    image: redis:7-alpine",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
      "id": "EbZYVewX",
      "type": "text",
      "x": -560.6383564433016,
      "y": 2788.412485181301,
      "width": 110,
      "height": 50,
