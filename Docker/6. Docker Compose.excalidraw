    },
    {
      "id": "QvUdErq8",
      "type": "text",
      "x": -572.2748754418812,
      "y": 2862.7760827043826,
      "width": 862.7269731001422,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 1768197510,
      "version": 458,
      "versionNonce": 728208474,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793998099490,
      "locked": false,
      "text": "-> build tells Docker Compose to build an image using a Dockerfile.\n-> . represents the current directory where the Dockerfile is located.\n-> Docker builds the backend image and creates a container from it.\n-> We can also use image: when we already have a pre-built image.",
      "rawText": "-> build tells Docker Compose to build an image using a Dockerfile.\n-> . represents the current directory where the Dockerfile is located.\n-> Docker builds the backend image and creates a container from it.\n-> We can also use image: when we already have a pre-built image.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> build tells Docker Compose to build an image using a Dockerfile.\n-> . represents the current directory where the Dockerfile is located.\n-> Docker builds the backend image and creates a container from it.\n-> We can also use image: when we already have a pre-built image.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
