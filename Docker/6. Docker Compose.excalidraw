      "text": "Why Not Expose Database and Redis Ports?",
      "rawText": "Why Not Expose Database and Redis Ports?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why Not Expose Database and Redis Ports?",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
      "id": "TGRuDww4",
      "type": "text",
      "x": -564.6386005839263,
      "y": 3045.685184710775,
      "width": 878.262850674716,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 2107680646,
      "version": 392,
      "versionNonce": 1652409818,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793998099490,
      "locked": false,
      "text": "-> Backend communicates with PostgreSQL and Redis through the internal Docker\nnetwork.\n-> We don't need to expose their ports to the outside world.\n-> Removing ports prevents direct access through the host's published ports.\n-> This improves security by reducing externally accessible services.",
      "rawText": "-> Backend communicates with PostgreSQL and Redis through the internal Docker network.\n-> We don't need to expose their ports to the outside world.\n-> Removing ports prevents direct access through the host's published ports.\n-> This improves security by reducing externally accessible services.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Backend communicates with PostgreSQL and Redis through the internal Docker network.\n-> We don't need to expose their ports to the outside world.\n-> Removing ports prevents direct access through the host's published ports.\n-> This improves security by reducing externally accessible services.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
