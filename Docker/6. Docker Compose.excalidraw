    },
    {
      "id": "jM2UD4NT",
      "type": "text",
      "x": -389.00228133676774,
      "y": 1435.5034109181618,
      "width": 1309.447265625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1040478170,
      "version": 230,
      "versionNonce": 198568602,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793996803114,
      "locked": false,
      "text": "When you run docker compose up, the following happens:\n\n-> A network called myapp_default is created.\n-> A container is created using web's configuration. It joins myapp_default under the name web.\n-> A container is created using db's configuration. It joins myapp_default under the name db.",
      "rawText": "When you run docker compose up, the following happens:\n\n-> A network called myapp_default is created.\n-> A container is created using web's configuration. It joins myapp_default under the name web.\n-> A container is created using db's configuration. It joins myapp_default under the name db.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When you run docker compose up, the following happens:\n\n-> A network called myapp_default is created.\n-> A container is created using web's configuration. It joins myapp_default under the name web.\n-> A container is created using db's configuration. It joins myapp_default under the name db.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
      "id": "vrwDL77Y",
      "type": "text",
      "x": -393.3659620896084,
      "y": 1633.321570541741,
      "width": 1588.271240234375,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 229059930,
      "version": 50,
      "versionNonce": 695588614,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793996801156,
      "locked": false,
      "text": "-> Each container can now look up the service name web or db and get back the appropriate container's IP address.\n-> The web service can connect to the database at postgres://db:5432",
      "rawText": "-> Each container can now look up the service name web or db and get back the appropriate container's IP address.\n-> The web service can connect to the database at postgres://db:5432",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Each container can now look up the service name web or db and get back the appropriate container's IP address.\n-> The web service can connect to the database at postgres://db:5432",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
      "id": "7Eb9yZYC",
      "type": "text",
      "x": -387.5477025903187,
      "y": 1263.7761159962868,
      "width": 1274.0686700994318,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 939522886,
      "version": 467,
      "versionNonce": 1222496282,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793996795908,
      "locked": false,
      "text": "-> Compose automatically connects all services to the default network, so you don't need to\ndefine networks explicitly in the Compose file.\n-> Compose creates a network named <project-name>_default and attaches all services to\nit.",
      "rawText": "-> Compose automatically connects all services to the default network, so you don't need to define networks explicitly in the Compose file.\n-> Compose creates a network named <project-name>_default and attaches all services to it.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Compose automatically connects all services to the default network, so you don't need to define networks explicitly in the Compose file.\n-> Compose creates a network named <project-name>_default and attaches all services to it.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
