    {
      "id": "5gDBKsea",
      "type": "text",
      "x": -253.72950967483575,
      "y": 1898.0487988798093,
      "width": 922.0116577148438,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 821495258,
      "version": 51,
      "versionNonce": 1967811802,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793996972146,
      "locked": false,
      "text": "-> Volumes are defined inside the volumes section.\n-> Each service mounts a volume using volume_name:container_path.",
      "rawText": "-> Volumes are defined inside the volumes section.\n-> Each service mounts a volume using volume_name:container_path.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Volumes are defined inside the volumes section.\n-> Each service mounts a volume using volume_name:container_path.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
      "id": "CzA6FxEi",
      "type": "text",
      "x": -253.3659620896084,
      "y": 1985.685184710775,
      "width": 708.3997192382812,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 1242126662,
      "version": 48,
      "versionNonce": 1189800474,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793996987298,
      "locked": false,
      "text": "services:\n  db:\n    volumes:\n      - postgres_data:/var/lib/postgresql/data\n\n  redis:\n    volumes:\n      - redis_data:/data\n\nvolumes:\n  postgres_data:\n  redis_data:",
      "rawText": "services:\n  db:\n    volumes:\n      - postgres_data:/var/lib/postgresql/data\n\n  redis:\n    volumes:\n      - redis_data:/data\n\nvolumes:\n  postgres_data:\n  redis_data:",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "services:\n  db:\n    volumes:\n      - postgres_data:/var/lib/postgresql/data\n\n  redis:\n    volumes:\n      - redis_data:/data\n\nvolumes:\n  postgres_data:\n  redis_data:",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
      "id": "IcnipdI3",
      "type": "text",
      "x": -230.45680459671064,
      "y": 2442.0488210744115,
      "width": 1137.3876953125,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 716324870,
      "version": 28,
      "versionNonce": 75369030,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793997030706,
      "locked": false,
      "text": "-> postgres_data stores PostgreSQL database files.\n-> redis_data stores Redis data.\n-> /var/lib/postgresql/data and /data are paths inside their respective containers.\n-> Docker automatically creates these named volumes if they don't exist.",
      "rawText": "-> postgres_data stores PostgreSQL database files.\n-> redis_data stores Redis data.\n-> /var/lib/postgresql/data and /data are paths inside their respective containers.\n-> Docker automatically creates these named volumes if they don't exist.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> postgres_data stores PostgreSQL database files.\n-> redis_data stores Redis data.\n-> /var/lib/postgresql/data and /data are paths inside their respective containers.\n-> Docker automatically creates these named volumes if they don't exist.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
