			"version": 424,
			"versionNonce": 1894246330,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1793830827884,
			"locked": false,
			"text": "docker -> Opens a help menu listing all the available command and uses.\ndocker ps -> Lists all the Running Docker Containers.\ndocker ps -a -> Lists all the Docker Containers.\ndocker ps --help -> Telling about different options for the given command.\ndocker images -> Lists all the images.\ndocker version -> To see the installed docker version.",
			"rawText": "docker -> Opens a help menu listing all the available command and uses.\ndocker ps -> Lists all the Running Docker Containers.\ndocker ps -a -> Lists all the Docker Containers.\ndocker ps --help -> Telling about different options for the given command.\ndocker images -> Lists all the images.\ndocker version -> To see the installed docker version.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "docker -> Opens a help menu listing all the available command and uses.\ndocker ps -> Lists all the Running Docker Containers.\ndocker ps -a -> Lists all the Docker Containers.\ndocker ps --help -> Telling about different options for the given command.\ndocker images -> Lists all the images.\ndocker version -> To see the installed docker version.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"link": null
		},
