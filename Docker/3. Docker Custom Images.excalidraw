      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
    {
      "id": "JwPosQwu",
      "type": "text",
      "x": -358.00006103515625,
      "y": 35.800048828125,
      "width": 858,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 1636210085,
      "version": 202,
      "versionNonce": 1675290027,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793871244405,
      "locked": false,
      "text": "# Base Image\nFROM ubuntu\n\nRUN apt-get update\nRUN apt install -y curl\nRUN curl -sL https://deb.nodesource.com/setup_18.x -o /tmp/nodesource_setup.sh\nRUN bash /tmp/nodesource_setup.sh\nRUN apt install -y nodejs\n\n# Copying the source code to docker image\nCOPY index.js /home/app/index.js\nCOPY package-lock.json /home/app/package-lock.json\nCOPY package.json /home/app/package.json\n\nWORKDIR /home/app/\n\nRUN npm install",
      "rawText": "# Base Image\nFROM ubuntu\n\nRUN apt-get update\nRUN apt install -y curl\nRUN curl -sL https://deb.nodesource.com/setup_18.x -o /tmp/nodesource_setup.sh\nRUN bash /tmp/nodesource_setup.sh\nRUN apt install -y nodejs\n\n# Copying the source code to docker image\nCOPY index.js /home/app/index.js\nCOPY package-lock.json /home/app/package-lock.json\nCOPY package.json /home/app/package.json\n\nWORKDIR /home/app/\n\nRUN npm install",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Base Image\nFROM ubuntu\n\nRUN apt-get update\nRUN apt install -y curl\nRUN curl -sL https://deb.nodesource.com/setup_18.x -o /tmp/nodesource_setup.sh\nRUN bash /tmp/nodesource_setup.sh\nRUN apt install -y nodejs\n\n# Copying the source code to docker image\nCOPY index.js /home/app/index.js\nCOPY package-lock.json /home/app/package-lock.json\nCOPY package.json /home/app/package.json\n\nWORKDIR /home/app/\n\nRUN npm install",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
