      "boundElements": [],
      "updated": 1793903405750,
      "locked": false,
      "text": "-P (capital P) enables automatic port mapping.\nDocker automatically assigns available host ports to the container's exposed ports.\nThe container port must be declared using EXPOSE in the Dockerfile.",
      "rawText": "-P (capital P) enables automatic port mapping.\nDocker automatically assigns available host ports to the container's exposed ports.\nThe container port must be declared using EXPOSE in the Dockerfile.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-P (capital P) enables automatic port mapping.\nDocker automatically assigns available host ports to the container's exposed ports.\nThe container port must be declared using EXPOSE in the Dockerfile.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
