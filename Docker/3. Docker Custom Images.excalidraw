      "boundElements": [],
      "updated": 1793903259505,
      "locked": false,
      "text": "-> Automatic port mapping is the process where Docker automatically assigns an available port on the host machine\nand maps it to a specified port inside the container, without requiring you to manually specify the host port.",
      "rawText": "-> Automatic port mapping is the process where Docker automatically assigns an available port on the host machine and maps it to a specified port inside the container, without requiring you to manually specify the host port.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Automatic port mapping is the process where Docker automatically assigns an available port on the host machine and maps it to a specified port inside the container, without requiring you to manually specify the host port.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
