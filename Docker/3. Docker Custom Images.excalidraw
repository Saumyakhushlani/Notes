    {
      "id": "TdVB5b0N",
      "type": "text",
      "x": -457.736800588251,
      "y": 4221.5362647694055,
      "width": 508.3994140625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0A",
      "roundness": null,
      "seed": 1520771563,
      "version": 14,
      "versionNonce": 1844464971,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793910758334,
      "locked": false,
      "text": "Problems:\n- Includes development dependencies in the final image.\n- Contains unnecessary source files and build tools.\n- Increases Docker image size.\n- Can increase the attack surface.",
      "rawText": "Problems:\n- Includes development dependencies in the final image.\n- Contains unnecessary source files and build tools.\n- Increases Docker image size.\n- Can increase the attack surface.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problems:\n- Includes development dependencies in the final image.\n- Contains unnecessary source files and build tools.\n- Increases Docker image size.\n- Can increase the attack surface.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
    {
      "id": "DgBU2V7A",
      "type": "text",
      "x": 208.67247448416697,
      "y": 4583.731581791849,
      "width": 787.3790283203125,
      "height": 150,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0B",
      "roundness": null,
      "seed": 1351995339,
      "version": 59,
      "versionNonce": 1548907851,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793910786809,
      "locked": false,
      "text": "Advantages of Multi-Stage Builds\n1. Smaller image size: Removes unnecessary build tools and files.\n2. Better security: Reduces the attack surface by excluding unnecessary components.\n3. Better performance: Smaller images are generally faster to transfer and deploy.\n4. Clean separation: Separates the build environment from the production environment.\n5. Efficient deployment: Only required runtime files are included in the final image.",
      "rawText": "Advantages of Multi-Stage Builds\n1. Smaller image size: Removes unnecessary build tools and files.\n2. Better security: Reduces the attack surface by excluding unnecessary components.\n3. Better performance: Smaller images are generally faster to transfer and deploy.\n4. Clean separation: Separates the build environment from the production environment.\n5. Efficient deployment: Only required runtime files are included in the final image.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Advantages of Multi-Stage Builds\n1. Smaller image size: Removes unnecessary build tools and files.\n2. Better security: Reduces the attack surface by excluding unnecessary components.\n3. Better performance: Smaller images are generally faster to transfer and deploy.\n4. Clean separation: Separates the build environment from the production environment.\n5. Efficient deployment: Only required runtime files are included in the final image.",
