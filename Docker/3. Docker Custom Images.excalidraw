      "text": "# Base Image\nFROM node:20.17.0-alpine3.19\n\nWORKDIR /home/app/\n\nCOPY package-lock.json package-lock.json\nCOPY package.json package.json\nRUN npm install\n\nCOPY index.js index.js\n\nEXPOSE 8000\n\nCMD [ \"npm\" , \"start\" ]",
      "rawText": "# Base Image\nFROM node:20.17.0-alpine3.19\n\nWORKDIR /home/app/\n\nCOPY package-lock.json package-lock.json\nCOPY package.json package.json\nRUN npm install\n\nCOPY index.js index.js\n\nEXPOSE 8000\n\nCMD [ \"npm\" , \"start\" ]",
      "fontSize": 20,
