      "updated": 1793898467216,
      "locked": false,
      "text": "# Base Image\nFROM node:20.17.0-alpine3.19\n\n# Copying the source code to docker image\nCOPY index.js /home/app/index.js\nCOPY package-lock.json /home/app/package-lock.json\nCOPY package.json /home/app/package.json\n\nWORKDIR /home/app/\n\nRUN npm install\n\nCMD [ \"npm\" , \"start\" ]",
      "rawText": "# Base Image\nFROM node:20.17.0-alpine3.19\n\n# Copying the source code to docker image\nCOPY index.js /home/app/index.js\nCOPY package-lock.json /home/app/package-lock.json\nCOPY package.json /home/app/package.json\n\nWORKDIR /home/app/\n\nRUN npm install\n\nCMD [ \"npm\" , \"start\" ]",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Base Image\nFROM node:20.17.0-alpine3.19\n\n# Copying the source code to docker image\nCOPY index.js /home/app/index.js\nCOPY package-lock.json /home/app/package-lock.json\nCOPY package.json /home/app/package.json\n\nWORKDIR /home/app/\n\nRUN npm install\n\nCMD [ \"npm\" , \"start\" ]",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
