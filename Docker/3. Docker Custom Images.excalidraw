      "isDeleted": false,
      "boundElements": [],
      "updated": 1793903088356,
      "locked": false,
      "text": "-> Port mapping is the process of connecting a port on the host machine to a port inside a Docker\ncontainer, allowing external users or applications to access services running inside the container.",
      "rawText": "-> Port mapping is the process of connecting a port on the host machine to a port inside a Docker container, allowing external users or applications to access services running inside the container.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Port mapping is the process of connecting a port on the host machine to a port inside a Docker container, allowing external users or applications to access services running inside the container.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
