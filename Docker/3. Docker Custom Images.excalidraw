    {
      "id": "pxunNgpj",
      "type": "text",
      "x": -569.181442810886,
      "y": 3561.9039309312743,
      "width": 1104.422120101184,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b03",
      "roundness": null,
      "seed": 1064106987,
      "version": 516,
      "versionNonce": 1028267397,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793911042312,
      "locked": false,
      "text": "-> Multi-stage builds in Docker are a technique in which multiple FROM instructions are used in a single\nDockerfile to create different stages (e.g., build and runtime). It allows us to copy only the required files from\none stage to another, reducing the final image size and improving security.\n-> Only the last stage is shared in the image nothing else.",
      "rawText": "-> Multi-stage builds in Docker are a technique in which multiple FROM instructions are used in a single Dockerfile to create different stages (e.g., build and runtime). It allows us to copy only the required files from one stage to another, reducing the final image size and improving security.\n-> Only the last stage is shared in the image nothing else.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Multi-stage builds in Docker are a technique in which multiple FROM instructions are used in a single Dockerfile to create different stages (e.g., build and runtime). It allows us to copy only the required files from one stage to another, reducing the final image size and improving security.\n-> Only the last stage is shared in the image nothing else.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
