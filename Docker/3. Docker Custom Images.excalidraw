      "updated": 1793910668582,
      "locked": false,
      "text": "FROM node:20-alpine3.19\n\nWORKDIR /home/app\n\nCOPY package*.json .\nCOPY tsconfig.json .\n\nRUN npm install\n\nCOPY src/ src/\n\nRUN npm run build\n\nCMD [\"npm\", \"start\"]",
      "rawText": "FROM node:20-alpine3.19\n\nWORKDIR /home/app\n\nCOPY package*.json .\nCOPY tsconfig.json .\n\nRUN npm install\n\nCOPY src/ src/\n\nRUN npm run build\n\nCMD [\"npm\", \"start\"]",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FROM node:20-alpine3.19\n\nWORKDIR /home/app\n\nCOPY package*.json .\nCOPY tsconfig.json .\n\nRUN npm install\n\nCOPY src/ src/\n\nRUN npm run build\n\nCMD [\"npm\", \"start\"]",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
