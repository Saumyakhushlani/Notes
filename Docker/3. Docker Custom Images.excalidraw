      "version": 92,
      "versionNonce": 1841528709,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793910695102,
      "locked": false,
      "text": "# Base Stage\nFROM node:20-alpine3.19 AS base\n\n# Stage 1: Build\nFROM base AS builder\n\nWORKDIR /home/build\n\nCOPY package*.json .\nCOPY tsconfig.json .\n\nRUN npm install\n\nCOPY src/ src/\n\nRUN npm run build\n\n\n# Stage 2: Runner\nFROM base AS runner\n\nWORKDIR /home/app\n\n# Copy only required files from builder stage\nCOPY --from=builder /home/build/dist dist/\nCOPY --from=builder /home/build/package*.json .\n\n# Install only production dependencies\nRUN npm install --omit=dev\n\nCMD [\"npm\", \"start\"]",
      "rawText": "# Base Stage\nFROM node:20-alpine3.19 AS base\n\n# Stage 1: Build\nFROM base AS builder\n\nWORKDIR /home/build\n\nCOPY package*.json .\nCOPY tsconfig.json .\n\nRUN npm install\n\nCOPY src/ src/\n\nRUN npm run build\n\n\n# Stage 2: Runner\nFROM base AS runner\n\nWORKDIR /home/app\n\n# Copy only required files from builder stage\nCOPY --from=builder /home/build/dist dist/\nCOPY --from=builder /home/build/package*.json .\n\n# Install only production dependencies\nRUN npm install --omit=dev\n\nCMD [\"npm\", \"start\"]",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Base Stage\nFROM node:20-alpine3.19 AS base\n\n# Stage 1: Build\nFROM base AS builder\n\nWORKDIR /home/build\n\nCOPY package*.json .\nCOPY tsconfig.json .\n\nRUN npm install\n\nCOPY src/ src/\n\nRUN npm run build\n\n\n# Stage 2: Runner\nFROM base AS runner\n\nWORKDIR /home/app\n\n# Copy only required files from builder stage\nCOPY --from=builder /home/build/dist dist/\nCOPY --from=builder /home/build/package*.json .\n\n# Install only production dependencies\nRUN npm install --omit=dev\n\nCMD [\"npm\", \"start\"]",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
