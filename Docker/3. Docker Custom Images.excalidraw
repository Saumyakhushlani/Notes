      "versionNonce": 2035179947,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793911493072,
      "locked": false,
      "text": "-> Instead of running containers as the default root user, we create a dedicated system user and\ngroup with specific UID and GID to run the application with limited privileges.",
      "rawText": "-> Instead of running containers as the default root user, we create a dedicated system user and group with specific UID and GID to run the application with limited privileges.",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Instead of running containers as the default root user, we create a dedicated system user and group with specific UID and GID to run the application with limited privileges.",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
    {
      "id": "EbpFf2o1",
      "type": "text",
      "x": -49.78138142223747,
      "y": 5146.612760045774,
      "width": 429,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0G",
      "roundness": null,
      "seed": 343807141,
      "version": 78,
      "versionNonce": 79878757,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793911653166,
      "locked": false,
      "text": "# Create a system group with GID 1001\nRUN addgroup --system --gid 1001 nodejs\n\n# Create a system user with UID 1001\nRUN adduser --system --uid 1001 nodejs\n\n# Switch to non-root user\nUSER nodejs\n\nENV PORT=8000\n\n# Start application\nCMD [\"npm\", \"start\"]",
      "rawText": "# Create a system group with GID 1001\nRUN addgroup --system --gid 1001 nodejs\n\n# Create a system user with UID 1001\nRUN adduser --system --uid 1001 nodejs\n\n# Switch to non-root user\nUSER nodejs\n\nENV PORT=8000\n\n# Start application\nCMD [\"npm\", \"start\"]",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# Create a system group with GID 1001\nRUN addgroup --system --gid 1001 nodejs\n\n# Create a system user with UID 1001\nRUN adduser --system --uid 1001 nodejs\n\n# Switch to non-root user\nUSER nodejs\n\nENV PORT=8000\n\n# Start application\nCMD [\"npm\", \"start\"]",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
      "id": "Ibml0FbQ",
      "type": "text",
      "x": -264.88873835617073,
      "y": 5481.865573697549,
      "width": 825.7307821066584,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
