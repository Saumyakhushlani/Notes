    {
      "id": "ZuR3F3ha",
      "type": "text",
      "x": -388.08351181608145,
      "y": 1360.125431218,
      "width": 859.50885442092,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 1545879109,
      "version": 977,
      "versionNonce": 649652613,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793899010751,
      "locked": false,
      "text": "-> All the layers are cached. So if we change something at level 5 then all the levels\nbelow level 5 will work again. \n-> So layering should be done like that things which will not change should be at top of\nDockerfile and vice versa.\n-> If there is a change in index.js i need not to npm install again this only needs to run\nwhen there is a change in package.json. ",
      "rawText": "-> All the layers are cached. So if we change something at level 5 then all the levels below level 5 will work again. \n-> So layering should be done like that things which will not change should be at top of Dockerfile and vice versa.\n-> If there is a change in index.js i need not to npm install again this only needs to run when there is a change in package.json. ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> All the layers are cached. So if we change something at level 5 then all the levels below level 5 will work again. \n-> So layering should be done like that things which will not change should be at top of Dockerfile and vice versa.\n-> If there is a change in index.js i need not to npm install again this only needs to run when there is a change in package.json. ",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "link": null
    },
