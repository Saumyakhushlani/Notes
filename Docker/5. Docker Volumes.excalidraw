      "versionNonce": 2035964870,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793992252215,
      "locked": false,
      "text": "What are Docker Volumes?",
      "rawText": "What are Docker Volumes?",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What are Docker Volumes?",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
      "id": "nGYy77bM",
      "type": "text",
      "x": -182.13330078125,
      "y": 200.60005696614587,
      "width": 937.2594604492188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 108931930,
      "version": 86,
      "versionNonce": 1734536538,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793992276736,
      "locked": false,
      "text": "-> Docker Volumes are mechanisms used to persist data generated and used by containers.\n-> They allow data to survive container deletion and can be shared between multiple containers.",
      "rawText": "-> Docker Volumes are mechanisms used to persist data generated and used by containers.\n-> They allow data to survive container deletion and can be shared between multiple containers.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> Docker Volumes are mechanisms used to persist data generated and used by containers.\n-> They allow data to survive container deletion and can be shared between multiple containers.",
      "autoResize": true,
      "lineHeight": 1.25,
      "hasTextLink": false
    },
    {
