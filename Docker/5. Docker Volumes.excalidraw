    {
      "id": "3Q0POZYe",
      "type": "text",
      "x": 57.00006103515625,
      "y": -78.5999755859375,
      "width": 448.923828125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
